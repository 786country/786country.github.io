---
import '../styles/global.css';
import { person, impact, projects, additional, experience, skills, certifications } from '../data/resume';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Naeem Ahmed — Staff Data Engineer & Tech Lead at Yoco. Chemical engineering foundations meet data science and applied AI in a brick-built portfolio." />
  <meta name="theme-color" content="#f7f4e9" />
  <title>Naeem Ahmed — Staff Data Engineer & Tech Lead</title>
  <link rel="icon" type="image/svg+xml" href="/brick.svg" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="header wrap">
  <a href="#" class="brand" aria-label="Naeem Ahmed home"><span class="brand-block">na<span>·</span></span><span>NAEEM AHMED<small>STAFF DATA ENGINEER / TECH LEAD</small></span></a>
  <nav aria-label="Main navigation"><a href="#experience">Experience</a><a href="#builds">Selected work</a><a href="#toolbox">Skills</a></nav>
  <a class="contact-link" href={`mailto:${person.email}`}>Let’s build <span aria-hidden="true">↗</span></a>
</header>
<main id="main">
<section class="hero wrap" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span class="dot"></span> NAEEM AHMED / YOCO</p>
    <h1 id="hero-title">Good data.<br /><span class="red-text">Solid foundations.</span></h1>
    <p class="hero-title">{person.title}</p>
    <p class="degree-tag">Chemical engineering graduate. Data platform builder.</p>
    <p class="intro">{person.intro}</p>
    <div class="hero-actions"><a class="button dark" href="#experience">See my experience <span aria-hidden="true">↓</span></a><a class="text-link" href="/files/Naeem%20Ahmed%20CV.pdf" download>Previous CV · pre-Yoco (PDF) <span aria-hidden="true">↗</span></a></div>
    <div class="set-meta"><span>SET NO. <b>NA–001</b></span><span>EST. <b>2016</b></span><span>LIMIT <b>NONE</b></span></div>
  </div>
  <div class="hero-art" role="img" aria-label="An exploded construction of colorful toy bricks, with a bearded yellow builder head at its center">
    <span class="art-note note-top">CHEMICAL ENGINEERING → DATA ENGINEERING</span>
    <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
    <div class="toy-brick brick-blue"><i></i><i></i><i></i><i></i><span>DATA</span></div>
    <div class="toy-brick brick-red"><i></i><i></i><i></i><i></i><span>CHEM ENG</span></div>
    <div class="toy-brick brick-green"><i></i><i></i><i></i><i></i><span>ENGINEERING</span></div>
    <div class="toy-brick brick-yellow"><i></i><i></i><i></i><i></i><span>CURIOSITY</span></div>
    <div class="builder"><div class="head-stud"></div><div class="head"><span class="hair"></span><span class="beard"></span><span class="eye left"></span><span class="eye right"></span><span class="smile"></span><span class="moustache"></span><span class="glasses"></span></div><div class="neck"></div></div>
    <span class="spark spark-one">✳</span><span class="spark spark-two">+</span><span class="art-tag">BUILT ON CURIOSITY</span>
    <span class="art-note note-bottom">UNDERSTAND THE PARTS. BUILD THE SYSTEM. <span aria-hidden="true">↗</span></span>
  </div>
</section>
<section class="impact-strip wrap" aria-labelledby="impact-title">
  <div class="impact-intro"><p class="eyebrow">RECENT RESULTS AT YOCO</p><h2 id="impact-title">Making Yoco’s data platform easier to run.</h2><p>Moving data reliably, reducing processing overhead, and lowering cloud costs.</p></div>
  <div class="impact-grid">{impact.slice(0, 3).map(item => <div class="impact-stat"><strong>{item.value}</strong><h3>{item.label}</h3><p>{item.detail}</p></div>)}</div>
  <p class="impact-source">Results from Yoco, through 5 Nov 2026. The scan reduction applies to database-history update queries, not the whole platform. Monthly savings come from separate query and storage fixes.</p>
</section>
<section class="experience wrap section-pad" id="experience" aria-labelledby="experience-title">
<div class="section-heading"><div><p class="eyebrow">01 / EXPERIENCE</p><h2 id="experience-title">From integrations<br />to platform leadership.</h2></div><button class="text-link print-button" id="print-cv">Print résumé <span aria-hidden="true">↗</span></button></div>
<div class="timeline">{experience.map((job, index) => <article class="job"><div class={`step ${job.color}`}>{String(index + 1).padStart(2, '0')}</div><div class="job-company"><h3>{job.company}</h3><p>{job.dates}</p></div><div class="roles">{job.roles.map(role => <div><small>{role.dates}</small><h4>{role.title}</h4><p>{role.text}</p>{'highlights' in role && role.highlights && <ul class="role-highlights">{role.highlights.map(highlight => <li>{highlight}</li>)}</ul>}</div>)}</div></article>)}</div>
<aside class="side-quest"><span class="eyebrow">BUSINESS EXPERIENCE</span><div><h3>Director · Revotech Computers</h3><p>Supplied electronics, repaired computers, and supported small and medium businesses with point-of-sale systems. This work involved understanding customer needs and solving practical technical problems.</p></div><span>From Jan 2011</span></aside>
<p class="source-note">Yoco experience updated through 5 November 2026. Entelect’s exact end date and Revotech’s current status remain to be confirmed from the earlier résumé.</p>
</section>
<section class="builds section-pad" id="builds" aria-labelledby="builds-title"><div class="wrap">
  <div class="section-heading"><div><p class="eyebrow">02 / SELECTED WORK</p><h2 id="builds-title">Three platform improvements.</h2></div><p>What I changed, and why it mattered.</p></div>
  <div class="project-grid">{projects.slice(0, 3).map(project => <article class={`project ${project.color}`} data-category={project.category}>
    <div class="project-top"><span>BUILD / {project.number}</span><span>Yoco</span></div>
    <div class="project-graphic" aria-hidden="true"><div class="graphic-brick g-one"><i></i><i></i><i></i></div><div class="graphic-brick g-two"><i></i><i></i><i></i></div><span>{project.number}</span></div>
    <div class="project-body"><p class="eyebrow">{project.label}</p><h3>{project.name}</h3><p>{project.description}</p><div class="tags">{project.stack.map(tag => <span>{tag}</span>)}</div><div class="project-meta"><b>{project.role}</b><span>{project.date}</span></div></div>
  </article>)}</div>
  <details class="other-builds"><summary>More projects · Yoco, Entelect & Deloitte <span aria-hidden="true">+</span></summary><div class="additional-grid">{projects.slice(3).map(project => <article><small>{project.label} · {project.date}</small><h3>{project.name}</h3><p>{project.description}</p></article>)}{additional.map(([name, description, dates]) => <article><small>{dates}</small><h3>{name}</h3><p>{description}</p></article>)}</div></details>
</div></section>
<section class="process-section wrap" aria-labelledby="process-title">
  <div class="process-caption"><p class="eyebrow">03 / ENGINEERING FOUNDATION</p><h2 id="process-title">Chemical engineering shaped how I solve problems.</h2><p>My BEng in Chemical Engineering taught me to think about connected processes: what goes in, what changes, and what comes out. I apply that same approach to data systems. The reactor below is a visual analogy for that way of working.</p></div>
  <div class="process-diagram" aria-label="An illustrative process: raw data enters a model reactor, becomes useful insight, and feeds back into the next iteration">
    <div class="process-node feed"><span class="equipment-id">INPUT / RAW DATA</span><div class="feed-bricks" aria-hidden="true"><i></i><i></i><i></i></div><h3>Raw data</h3><p>Start with the inputs.</p></div>
    <span class="process-arrow" aria-hidden="true">→</span>
    <div class="process-node reactor"><span class="equipment-id">PROCESS / DATA JOBS</span><div class="reactor-vessel" aria-hidden="true"><span class="agitator"></span><span class="reactor-liquid"></span><i></i><i></i><i></i></div><h3>Clean & transform</h3><p>Check, organise, calculate.</p></div>
    <span class="process-arrow" aria-hidden="true">→</span>
    <div class="process-node product"><span class="equipment-id">OUTPUT / READY TO USE</span><div class="product-brick" aria-hidden="true"><i></i><i></i></div><h3>Usable data</h3><p>For analysis and services.</p></div>
    <div class="feedback-line"><span>↶ FEEDBACK LOOP · LEARN, REFINE, REBUILD</span></div>
  </div>
</section>
<section class="toolbox section-pad" id="toolbox" aria-labelledby="toolbox-title"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">04 / SKILLS & EDUCATION</p><h2 id="toolbox-title">What I work with.</h2></div><p>Tools I use to build and run data platforms.</p></div><div class="skill-grid">{skills.map(skill => <article class={`skill ${skill.color}`}><div class="studs" aria-hidden="true"><i></i><i></i><i></i><i></i></div><p class="eyebrow">{skill.subtitle}</p><h3>{skill.title}</h3><ul>{skill.items.map(item => <li>{item}</li>)}</ul></article>)}</div>
<div class="credentials"><div><p class="eyebrow">UNIVERSITY DEGREE</p><h3>BEng · Chemical Engineering</h3><p>University of Pretoria · 2013–2016</p><p class="school">National Senior Certificate & Cambridge O Level · Central Islamic School · 2007–2011</p></div><div><p class="eyebrow">BEYOND THE KEYBOARD</p><h3>Away from the data.</h3><p>When I’m away from the keyboard, you’ll find me closer to nature.</p></div></div>
<section class="certification-section" aria-labelledby="certifications-title">
  <div class="cert-heading"><div><p class="eyebrow">THE LEARNING CONTINUES</p><h3 id="certifications-title">Certifications & training</h3></div><a class="cert-profile" href={`${person.linkedin}details/certifications/`} target="_blank" rel="noreferrer">View LinkedIn ↗</a></div>
  <ul class="certification-list">{certifications.map(cert => <li>
    <div class="cert-copy"><h4>{cert.name}</h4><p>{cert.issuer}{cert.issued && <> · Issued {cert.issued}</>}</p>{cert.status && <span class="cert-expired">{cert.status}</span>}</div>
    {cert.url && <a class="cert-verify" href={cert.url} target="_blank" rel="noreferrer" aria-label={`View credential: ${cert.name}`}>Credential ↗</a>}
  </li>)}</ul>
  <p class="cert-note">Professional certifications and completed training courses are listed together. Issue dates are shown where available; the AWS certification expired in May 2023.</p>
</section>
</div></section>
<section class="contact wrap" id="contact"><div class="contact-top"><p class="eyebrow">05 / GET IN TOUCH</p><span class="tiny-brick" aria-hidden="true"></span></div><h2>Something to build?<br /><span>Let’s talk.</span></h2><a class="button dark" href={`mailto:${person.email}`}>Start a conversation <span aria-hidden="true">↗</span></a><div class="contact-bottom"><a href={`mailto:${person.email}`}>{person.email}</a><div><a href={person.github}>GitHub ↗</a><a href={person.linkedin}>LinkedIn ↗</a></div></div></section>
</main>
<footer class="wrap"><span>© {new Date().getFullYear()} Naeem Ahmed. Always a work in progress.</span><span>BUILT WITH ASTRO. ASSEMBLED WITH CURIOSITY.</span><p>An independent, brick-inspired portfolio. Not affiliated with or endorsed by the LEGO Group.</p></footer>
<script>
  document.querySelector('#print-cv')?.addEventListener('click', () => window.print());
</script>
</body></html>
